{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "5guys1direction",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "rm -rf .git"
  }
}
